{
  "name": "reqster",
  "private": true,
  "version": "1.1.2-rc.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reqster-dev/reqster.git"
  },
  "homepage": "https://reqster.dev",
  "description": "Tamamen yerel çalışan, hafif ve veri gizliliği odaklı API istemcisi",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/app"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:app",
    "dev:server": "npm run dev -w @reqster/server",
    "dev:app": "npm run dev -w @reqster/app",
    "build": "npm run build -w @reqster/shared && npm run build -w @reqster/server && npm run build -w @reqster/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run build -w @reqster/app && npm run start -w @reqster/server",
    "package:linux": "node launcher/package.mjs --target linux-x64",
    "sidecar:win": "node launcher/package.mjs --target win-x64 --sidecar-dir src-tauri --no-archive",
    "sidecar:linux": "node launcher/package.mjs --target linux-x64 --sidecar-dir src-tauri --no-archive",
    "portable:win": "deploy/win-portable.sh",
    "release": "deploy/surum.sh",
    "smoke": "node launcher/smoke.mjs dist/package/linux-x64/Reqster/reqster",
    "tauri": "tauri",
    "notices": "node launcher/third-party-notices.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.0",
    "npm-run-all": "^4.1.5",
    "postject": "^1.0.0-alpha.6"
  }
}
